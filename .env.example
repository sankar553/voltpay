# Copy to .env.local and fill in.  Never commit real secrets.

# --- Database (local: docker compose up -d) ---
DATABASE_URL=postgres://voltpay:voltpay@localhost:5432/voltpay

# --- Auth ---
# Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Seed accounts (optional; dev defaults are used if blank, required in production) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=
SEED_CUSTOMER_PASSWORD=

