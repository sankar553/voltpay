# Copy to .env.local and fill in.  Never commit real secrets.

# --- Database: Neon (https://neon.tech, free tier) ---
# Neon dashboard → your project → "Connect" → copy the connection string.
# Keep "?sslmode=verify-full" at the end.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=verify-full

# --- Auth ---
# Generate each secret with:  openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- QR codes: signs the URL on every meter sticker (changing it invalidates printed QRs) ---
QR_SIGNING_SECRET=

# --- Razorpay (test mode) ---
# While these are placeholders the app uses a simulated checkout (development only).
# Replace with your keys from Razorpay Dashboard → Test Mode → Account & Settings → API Keys.
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder
# Dashboard → Account & Settings → Webhooks → add  https://<your-domain>/api/webhooks/razorpay
# with events payment.captured and payment.failed, then paste its secret here.
RAZORPAY_WEBHOOK_SECRET=placeholder

# --- Seed accounts (optional; dev defaults are used if blank, required in production) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=
SEED_CUSTOMER_PASSWORD=

# --- Reminder emails (Resend, https://resend.com, free tier) ---
# Leave RESEND_API_KEY empty in development: reminders are printed to the server console instead.
# With the default sender below, Resend only delivers to your own Resend account email until you verify a domain.
RESEND_API_KEY=
EMAIL_FROM=VoltPay <onboarding@resend.dev>

# --- Protects /api/cron/daily (Vercel Cron sends it automatically). Generate: openssl rand -base64 32 ---
CRON_SECRET=
